{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CHATBOT_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "displayName": "Desarrollo (Debug con warnings)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "asan",
            "inherits": "dev",
            "displayName": "Debug con AddressSanitizer + UndefinedBehaviorSanitizer",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "tsan",
            "inherits": "dev",
            "displayName": "Debug con ThreadSanitizer",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (optimizada, para uso diario)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "dev-telegram",
            "inherits": "dev",
            "displayName": "Desarrollo con el addon de Telegram",
            "cacheVariables": {
                "CHATBOT_BUILD_TELEGRAM": "ON"
            }
        },
        {
            "name": "release-telegram",
            "inherits": "release",
            "displayName": "Release con el addon de Telegram",
            "cacheVariables": {
                "CHATBOT_BUILD_TELEGRAM": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "tsan", "configurePreset": "tsan" },
        { "name": "release", "configurePreset": "release" },
        { "name": "dev-telegram", "configurePreset": "dev-telegram" },
        { "name": "release-telegram", "configurePreset": "release-telegram" }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "tsan",
            "configurePreset": "tsan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "dev-telegram",
            "configurePreset": "dev-telegram",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "release-telegram",
            "configurePreset": "release-telegram",
            "output": { "outputOnFailure": true }
        }
    ]
}
